# Server Configuration (Use 5001 on macOS to avoid Apple AirPlay/ControlCenter port 5000 conflict)
PORT=5001
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/proofbox

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Google OAuth 2.0 (Configure via Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
